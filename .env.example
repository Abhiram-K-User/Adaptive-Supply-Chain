# ==============================================================================
# ASCI Platform v2.0 — Environment Configuration Template
# Copy this file to `.env` (already in .gitignore) and fill in the values you need.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Runtime & Persistence
# ------------------------------------------------------------------------------
# Corridor network topology scale: "v0_core" (23 nodes) or "v1_corridor" (118 nodes)
ASCI_NETWORK_SCALE=v1_corridor

# Optional directory path for persistent SQLite databases (events, timeseries,
# decisions) and JSONL execution traces. Leave empty for ephemeral :memory: mode.
ASCI_DATA_DIR=

# ------------------------------------------------------------------------------
# 2. Multi-Provider LLM Selection (Optional — falls back deterministically)
# ------------------------------------------------------------------------------
# Provider mode: "auto" | "groq" | "gemini" | "openai" | "ollama" | "deterministic"
# In "auto" mode, priority order is: GROQ_API_KEY -> GEMINI_API_KEY -> OPENAI_API_KEY -> OLLAMA_HOST
ASCI_LLM_PROVIDER=auto

# Optional model override for the active provider. Leave blank to use provider defaults:
#   groq         -> openai/gpt-oss-20b   (120B free-tier alternative: openai/gpt-oss-120b)
#   gemini       -> gemini-2.5-flash
#   openai       -> gpt-4o-mini
#   ollama       -> llama3.1
ASCI_LLM_MODEL=

# ------------------------------------------------------------------------------
# 3. Provider Credentials & Endpoints (Set ONLY the provider you want to use)
# ------------------------------------------------------------------------------
# Groq API (Free developer tier; default model: openai/gpt-oss-20b)
GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Google Gemini API
# GEMINI_API_KEY=

# OpenAI or OpenAI-compatible API (OpenRouter, Together, vLLM, etc.)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Local Ollama (No API key needed)
# OLLAMA_HOST=http://localhost:11434
# ASCI_OLLAMA_ENABLED=false

# ------------------------------------------------------------------------------
# 4. Live Data Feeds (Public APIs — No Extra API Keys Required)
# ------------------------------------------------------------------------------
# Enable live internet feed polling mode for the Control Tower UI & demo preload
ASCI_LIVE_FEEDS_ENABLED=true

# Optional dashboard auto-poll interval in seconds (0 = manual poll button only)
ASCI_LIVE_POLL_INTERVAL_SECONDS=0

# Per-adapter HTTP timeout in seconds when polling external live feeds
ASCI_FEED_TIMEOUT_SECONDS=6.0

# Optional public feed endpoint overrides (all work without API keys by default):
# ASCI_GDACS_API_URL=https://www.gdacs.org/gdacsapi/api/events/geteventlist/SEARCH
# ASCI_GDELT_API_URL=https://api.gdeltproject.org/api/v2/doc/doc
# ASCI_NEWS_RSS_URL=https://news.google.com/rss/search
# ASCI_WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
# ASCI_PORTWATCH_API_URL=https://services9.arcgis.com/weJ1QsnbMYJlCHdG/arcgis/rest/services/Daily_Ports_Data/FeatureServer/0/query

